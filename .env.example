APP_ENV=local
LOG_LEVEL=INFO

# Training data directory — change to real data path when available
# e.g. DATA_DIR=/mnt/real_data/processed
DATA_DIR=data/seeds

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=sentinel.transactions
KAFKA_VERDICTS_TOPIC=sentinel.verdicts
KAFKA_RETRAINING_TOPIC=sentinel.retraining
KAFKA_OTP_EVENTS_TOPIC=sentinel.otp_events

REDIS_URL=redis://localhost:6379/0

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentinelpass

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel_audit
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel_audit

MLFLOW_TRACKING_URI=http://localhost:5050

OTP_PROVIDER=mock
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SPARROW_TOKEN=
SPARROW_IDENTITY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
